# ---------------------------------------------------------------------------
# Outputs written by the benchmark and validation runs. Runs never rewrite
# tracked files: their evidence (including run hash manifests and rebuilt
# models/references) goes into results/-type folders listed here.
# ---------------------------------------------------------------------------
results/
results_*/
compiled_local/
audit_local/
native_audit_local/
MUJOCO_LOG.TXT

# Excavator
/Excavator_CMG_PACDM/outputs/
/Excavator_CMG_PACDM/figures/
/Excavator_CMG_PACDM/v26/outputs/

# Go2 (the main MuJoCo run generates data/, derived/ and figures/)
/Go2_CMG_PACDM/data/
/Go2_CMG_PACDM/derived/
/Go2_CMG_PACDM/figures/
/Go2_CMG_PACDM/workflows/generated/audit_*/
/Go2_CMG_PACDM/workflows/generated/presentation/
/Go2_CMG_PACDM/workflows/isaac/figures/

# Kangaroo (generated models, references and videos; data/ keeps two tracked files)
/Kangaroo_CMG_PACDM/data/*
!/Kangaroo_CMG_PACDM/data/contact_acceptance.json
!/Kangaroo_CMG_PACDM/data/provenance.json
/Kangaroo_CMG_PACDM/models/
/Kangaroo_CMG_PACDM/videos/

# Panda
/Panda_CMG_PACDM/compiler_studies/benchmark/inputs/physical_graph_regenerated.json

# Stewart (Supplement figures and audit records)
/Stewart_CMG_PACDM/Supplement/figures/
/Stewart_CMG_PACDM/Supplement/audit_metrics.json
/Stewart_CMG_PACDM/Supplement/recomputed_metrics.json
